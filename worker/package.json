{
  "name": "viaminus-signalements",
  "version": "0.1.0",
  "private": true,
  "description": "Service de signalements partagés anonymes « pompe vide » pour ViaMinus (Cloudflare Worker + D1)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "migrations:local": "wrangler d1 migrations apply viaminus-signalements --local",
    "migrations:remote": "wrangler d1 migrations apply viaminus-signalements --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
